#!/bin/sh
# S45ntpd — synchronise system time from NTP pool servers.
# Runs after the network init script (S40network) brings up DHCP.
# busybox ntpd keeps running and re-syncs periodically.

NTPD=$(command -v ntpd)
PIDFILE=/var/run/ntpd.pid
SERVERS="0.pool.ntp.org 1.pool.ntp.org 2.pool.ntp.org 3.pool.ntp.org"

case "$1" in
    start)
        if [ ! -x "$NTPD" ]; then
            echo "ntpd not found, skipping NTP sync"
            exit 0
        fi
        # busybox ntpd resolves its peers once at startup and exits with
        # "bad address" when DNS is not usable yet (DHCP lease / resolver
        # not in place). Wait for name resolution before starting it.
        echo -n "Waiting for DNS: "
        i=0
        while [ $i -lt 60 ]; do
            if nslookup "$(echo $SERVERS | cut -d' ' -f1)" >/dev/null 2>&1; then
                echo "OK"
                break
            fi
            i=$((i + 1))
            sleep 1
        done
        if [ $i -ge 60 ]; then
            echo "timeout (starting ntpd anyway; it will retry)"
        fi
        echo "Starting ntpd (NTP time sync)..."
        args=""
        for s in $SERVERS; do
            args="$args -p $s"
        done
        # -N: run in foreground once to sync (waits for the first reply,
        # so the clock is right before curl/HTTPS services start),
        # then keep running as the periodic daemon.
        start-stop-daemon -S -q -m -p "$PIDFILE" -x "$NTPD" -- -N $args
        ;;
    stop)
        start-stop-daemon -K -q -p "$PIDFILE"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
