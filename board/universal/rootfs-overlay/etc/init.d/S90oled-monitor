#!/bin/sh
#
# S90oled-monitor — start/stop the OLED system monitor
#

SCRIPT=/usr/local/bin/oled-monitor.py
PIDFILE=/var/run/oled-monitor.pid
LOGFILE=/var/log/oled-monitor.log

start() {
    echo -n "Starting oled-monitor: "
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
        echo "already running"
        return 0
    fi
    # Ensure i2c-dev is loaded so /dev/i2c-1 exists
    modprobe i2c-dev 2>/dev/null || true
    # Loop-restart: a crashed monitor leaves the panel unpolled (encoder
    # dead, animations frozen), so respawn it with a short backoff.
    (
        while true; do
            python3 "$SCRIPT" >> "$LOGFILE" 2>&1
            echo "$(date) oled-monitor exited ($?), restarting in 5s" >> "$LOGFILE"
            sleep 5
        done
    ) &
    echo $! > "$PIDFILE"
    echo "OK"
}

stop() {
    echo -n "Stopping oled-monitor: "
    if [ -f "$PIDFILE" ]; then
        # Kill the supervisor shell and any python it spawned.
        pid=$(cat "$PIDFILE")
        pkill -P "$pid" 2>/dev/null
        kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
        echo "OK"
    else
        echo "not running"
    fi
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
        echo "oled-monitor is running (supervisor PID $(cat $PIDFILE))"
    else
        echo "oled-monitor is not running"
    fi
}

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) restart ;;
    status)  status  ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
