# Busybox config fragment for µNeuron.
# Ensures the ntpd applet is always available for NTP time sync
# (used by etc/init.d/S45ntpd and the muneuron utility).
CONFIG_NTPD=y

# Busybox wget with HTTPS support (TLS via the internal or linked TLS
# implementation). Without this, wget only speaks plain HTTP and fails
# on https:// URLs with "ssl_client: not found" or similar.
CONFIG_FEATURE_WGET_HTTPS=y
